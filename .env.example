# Server-side URL used by Next.js to proxy /api requests.
CHOICELAB_API_URL=http://127.0.0.1:8000

# Show the public demonstration notice in the participant interface.
NEXT_PUBLIC_CHOICELAB_DEMO_MODE=false

# Keep disabled on public deployments unless a protected researcher service is added.
CHOICELAB_ENABLE_RESEARCHER_SUMMARY=false
# Required whenever the researcher summary is enabled.
CHOICELAB_RESEARCHER_TOKEN=

# SQLite path used by the API.
CHOICELAB_DATABASE_PATH=apps/api/data/choicelab.sqlite3
